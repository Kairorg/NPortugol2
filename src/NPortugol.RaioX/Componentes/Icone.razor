@* Ícones em SVG inline (traço na cor do texto). *@
<svg class="icone @Classe" width="@Tamanho" height="@Tamanho" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Nome)
    {
        case "explorador":
            <path d="M8 3h7l4 4v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
            <path d="M14 3v5h5" />
            <path d="M9 13h6M9 17h4" />
            break;
        case "execucao":
            <rect x="8" y="7" width="8" height="12" rx="4" />
            <path d="M12 7V4M8 11H4M20 11h-4M8 15H5M19 15h-3M9.5 4.5 8 3M14.5 4.5 16 3" />
            break;
        case "executar":
            <path d="M7 5l12 7-12 7z" fill="currentColor" stroke="none" />
            break;
        case "depurar":
            <path d="M6 5l10 7-10 7z" />
            <circle cx="18.5" cy="17.5" r="3" fill="currentColor" stroke="none" />
            break;
        case "continuar":
            <path d="M6 5v14" />
            <path d="M10 5l10 7-10 7z" fill="currentColor" stroke="none" />
            break;
        case "proxima-linha":
            <path d="M4 13a8 8 0 0 1 14.5-4.5" />
            <path d="M19 4v5h-5" />
            <circle cx="12" cy="19" r="2" fill="currentColor" stroke="none" />
            break;
        case "proxima-instrucao":
            <path d="M12 3v11" />
            <path d="M8 10l4 4 4-4" />
            <circle cx="12" cy="19.5" r="2" fill="currentColor" stroke="none" />
            break;
        case "parar":
            <rect x="6" y="6" width="12" height="12" rx="1.5" fill="currentColor" stroke="none" />
            break;
        case "compartilhar":
            <circle cx="6" cy="12" r="2.5" />
            <circle cx="18" cy="6" r="2.5" />
            <circle cx="18" cy="18" r="2.5" />
            <path d="M8.2 10.9l7.6-3.8M8.2 13.1l7.6 3.8" />
            break;
        case "arvore":
            <rect x="9" y="3" width="6" height="5" rx="1" />
            <rect x="3" y="16" width="6" height="5" rx="1" />
            <rect x="15" y="16" width="6" height="5" rx="1" />
            <path d="M12 8v4M6 16v-4h12v4" />
            break;
        case "assembly":
            <path d="M4 6h16M4 10h10M4 14h16M4 18h8" />
            break;
        case "erro":
            <circle cx="12" cy="12" r="9" />
            <path d="M9 9l6 6M15 9l-6 6" />
            break;
        case "seta":
            <path d="M9 6l6 6-6 6" />
            break;
        case "arquivo":
            <path d="M8 3h7l4 4v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" />
            <path d="M14 3v5h5" />
            break;
        case "funcao":
            <path d="M14 4h-1a3 3 0 0 0-3 3v10a3 3 0 0 1-3 3H6" />
            <path d="M7 11h7" />
            break;
        case "editar":
            <path d="M4 20h4L19 9l-4-4L4 16z" />
            <path d="M13.5 6.5l4 4" />
            break;
        case "fechar":
            <path d="M6 6l12 12M18 6L6 18" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Nome { get; set; } = "";
    [Parameter] public int Tamanho { get; set; } = 16;
    [Parameter] public string? Classe { get; set; }
}
