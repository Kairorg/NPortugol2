<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- NPortugol Raio-X: mostra o que o compilador e a VM fazem com o programa (AST, assembly
       gerado e execução passo a passo). Sucessor web do GrammarIDE. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- A VM depende da cultura pt-BR, que precisa estar disponível em qualquer navegador. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <!-- A VM acessa propriedades por reflexão; o trimming não deve remover nada do NPortugol. -->
    <TrimmerRootAssembly Include="NPortugol" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazorMonaco" Version="3.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NPortugol\NPortugol.csproj" />
    <ProjectReference Include="..\NPortugol.Blazor\NPortugol.Blazor.csproj" />
  </ItemGroup>

</Project>
