<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="OutDir">

  <PropertyGroup>
    <!-- net48 para as ferramentas Windows; netstandard2.0 para .NET moderno e o playground web. -->
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <RootNamespace>NPortugol</RootNamespace>
    <AssemblyName>NPortugol</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.0</Version>
    <Company>Ricardo Borges</Company>
    <Product>NPortugol</Product>
    <Copyright>Copyright (c) Ricardo Borges 2014</Copyright>
    <!-- Código gerado pelo ANTLR (src/NPortugol/Generated) usa atributos CLSCompliant. -->
    <NoWarn>$(NoWarn);CS3021</NoWarn>
  </PropertyGroup>

  <!-- O build.config grava todos os projetos em build\; sem isto as duas NPortugol.dll se sobrescreveriam. -->
  <PropertyGroup Condition="'$(OutDir)' != '' and '$(TargetFramework)' == 'netstandard2.0'">
    <OutDir>$(OutDir)netstandard2.0\</OutDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- Prova de conceito com DynamicMethod (Reflection.Emit), indisponível no netstandard2.0. -->
    <Compile Remove="ILTranslator.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 4.13.1 é a versão mais recente do runtime C# no NuGet; é compatível com o código
         gerado pela ferramenta ANTLR 4.13.2 (tools/antlr4). -->
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>

</Project>
