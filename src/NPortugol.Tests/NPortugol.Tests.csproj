<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="OutDir">

  <PropertyGroup>
    <!-- net48 testa a biblioteca .NET Framework; net10.0 testa a versão netstandard2.0. -->
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>NPortugol.Tests</RootNamespace>
    <AssemblyName>NPortugol.Tests</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- O build.config grava todos os projetos em build\; separa a saída net10.0. -->
  <PropertyGroup Condition="'$(OutDir)' != '' and '$(TargetFramework)' == 'net10.0'">
    <OutDir>$(OutDir)net10.0\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fora do projeto desde a versão .NET 3.5 (não compila com a API atual). -->
    <Compile Remove="Runtime\Integration\HostContainerTestCase.cs" />
    <None Include="Runtime\Integration\HostContainerTestCase.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <!-- O ILTranslator só existe na versão net48 da biblioteca. -->
    <Compile Remove="TranslationTestCase.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NPortugol\NPortugol.csproj" />
  </ItemGroup>

</Project>
