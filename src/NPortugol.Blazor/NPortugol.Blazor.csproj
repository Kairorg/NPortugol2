<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Código comum aos sites Blazor do NPortugol (playground e Raio-X): integração da linguagem
       com o Monaco (wwwroot/nportugol.js), entrada e saída, exemplos e link compartilhável. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Exemplos\*.np" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NPortugol\NPortugol.csproj" />
  </ItemGroup>

</Project>
