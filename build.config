<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Integrate">
  <PropertyGroup>
  
    <RootDir>$(MSBuildProjectDirectory)\</RootDir>
    <BuildDir>$(RootDir)build\</BuildDir>
    <PackageDir>$(RootDir)\pkg\</PackageDir>
    <SourceDir>$(RootDir)\src\</SourceDir>
    <LibDir>$(RootDir)\lib\</LibDir>

    <Configuration>Release</Configuration>
    <!-- "AnyCPU" (sem espaço) porque os projetos são compilados diretamente, sem a solução. -->
    <Platform>AnyCPU</Platform>

    <ProductVersionBase>1.0</ProductVersionBase>
    <ProductVersionBuild>.0</ProductVersionBuild>
   
    <MainLibraryName>NPortugol-$(ProductVersionBase)$(ProductVersionBuild)</MainLibraryName>
    <ToolName>GrammarIDE-$(ProductVersionBase)$(ProductVersionBuild)</ToolName>
    <IDEName>TurboNPortugol-$(ProductVersionBase)$(ProductVersionBuild)</IDEName>
    <NpcName>NpcConsole-$(ProductVersionBase)$(ProductVersionBuild)</NpcName>
    <PlaygroundName>NPortugol-Playground-$(ProductVersionBase)$(ProductVersionBuild)</PlaygroundName>
    <RaioXName>NPortugol-RaioX-$(ProductVersionBase)$(ProductVersionBuild)</RaioXName>

    <TestAssembly>$(BuildDir)\NPortugol.Tests.dll</TestAssembly>
    <TestAssemblyModerno>$(BuildDir)\net10.0\NPortugol.Tests.dll</TestAssemblyModerno>
    <PlaygroundDir>$(BuildDir)playground\</PlaygroundDir>
    <RaioXDir>$(BuildDir)raiox\</RaioXDir>
  </PropertyGroup>

  <!-- Os projetos da solução, exceto os sites Blazor (playground, Raio-X e a biblioteca comum):
       eles são publicados à parte (PackagePlayground, PackageRaioX), porque gravá-los em build\
       misturaria os sites com os arquivos das ferramentas. -->
  <ItemGroup>
    <SolutionFile Include="$(SourceDir)\NPortugol\NPortugol.csproj" />
    <SolutionFile Include="$(SourceDir)\NPortugol.Tests\NPortugol.Tests.csproj" />
    <SolutionFile Include="$(SourceDir)\GrammarIDE\GrammarIDE.csproj" />
    <SolutionFile Include="$(SourceDir)\TurboNPortugol\TurboNPortugol.csproj" />
    <SolutionFile Include="$(SourceDir)\Npc\Npc.csproj" />
    <SolutionFile Include="$(SourceDir)\NPortugol.Web\NPortugol.Web.2010.csproj" />
  </ItemGroup>

  <Import Project="tools\msbuild\MSBuild.Community.Tasks.Targets"/>

  <Target Name="Clean">
    <MSBuild Projects="@(SolutionFile)" Targets="Clean" Properties="Configuration=$(Configuration);Platform=$(Platform);SolutionDir=$(SourceDir);OutDir=$(BuildDir)"/>
    <RemoveDir Directories="$(BuildDir)" ContinueOnError="true"/>
    <RemoveDir Directories="$(PackageDir)" ContinueOnError="true"/>
  </Target>

  <!-- A versão do assembly NPortugol.dll vem da propriedade Version (src/NPortugol/NPortugol.csproj). -->
  <Target Name="Build">
    <Message Text="##teamcity[buildNumber '$(ProductVersionBase)$(ProductVersionBuild)']"/>
    <!-- Restore em chamada separada (com propriedade extra) para o MSBuild reavaliar os projetos depois. -->
    <MSBuild Projects="@(SolutionFile)" Targets="Restore" Properties="Configuration=$(Configuration);Platform=$(Platform);SolutionDir=$(SourceDir);_NPRestore=true"/>
    <MSBuild Projects="@(SolutionFile)" Properties="Configuration=$(Configuration);Platform=$(Platform);SolutionDir=$(SourceDir);OutDir=$(BuildDir);Version=$(ProductVersionBase)$(ProductVersionBuild)"/>
  </Target>

  <Target Name="Rebuild">
    <CallTarget Targets="Clean; Build"></CallTarget>
  </Target>

  <Target Name="Test" DependsOnTargets="Build">
    <Exec Command="dotnet test &quot;$(TestAssembly)&quot; --nologo" />
    <Exec Command="dotnet test &quot;$(TestAssemblyModerno)&quot; --nologo" />
  </Target>

    <Target  Name="PackageGrammarIDE" DependsOnTargets="Rebuild">

      <ItemGroup>
        <FilesToPackage Include="$(BuildDir)**\*.*" Exclude="$(BuildDir)*Turbo*;$(BuildDir)net10.0\**;$(BuildDir)netstandard2.0\**;$(PlaygroundDir)**;$(RaioXDir)**" />
      </ItemGroup>
      <Zip
      Files="@(FilesToPackage)"
      ZipLevel="6"
      WorkingDirectory="$(BuildDir)"
      ZipFileName="$(BuildDir)\$(ToolName).zip"/>

  </Target>

  <Target  Name="PackageTNP" DependsOnTargets="Rebuild">

    <ItemGroup>
      <FilesToIDE Include="$(BuildDir)*.*" Exclude="$(BuildDir)*Grammar*" />
    </ItemGroup>
    <Zip
    Files="@(FilesToIDE)"
    ZipLevel="6"
    WorkingDirectory="$(BuildDir)"
    ZipFileName="$(BuildDir)\$(IDEName).zip"/>

  </Target>

  <Target  Name="PackageLib" DependsOnTargets="Rebuild">

    <ItemGroup>
      <FilesToLIB Include="$(BuildDir)\NPortugol.dll"/>
      <FilesToLIB Include="$(BuildDir)\Antlr4.Runtime.Standard.dll"/>
    </ItemGroup>
    <Zip
    Files="@(FilesToLIB)"
    ZipLevel="6"
    WorkingDirectory="$(BuildDir)"
    ZipFileName="$(BuildDir)\$(MainLibraryName).zip"/>
  </Target>


  <Target  Name="PackageNpc" DependsOnTargets="Merge">

    <ItemGroup>
      <FilesToNpc Include="$(BuildDir)\Npc.exe"/>
    </ItemGroup>
    <Zip
    Files="@(FilesToNpc)"
    ZipLevel="6"
    WorkingDirectory="$(BuildDir)"
    ZipFileName="$(BuildDir)\$(NpcName).zip"/>
  </Target>

  <!-- Publica o playground (Blazor WebAssembly) e empacota o site estático, pronto para hospedar. -->
  <Target Name="PackagePlayground">
    <RemoveDir Directories="$(PlaygroundDir)" ContinueOnError="true"/>
    <Exec Command="dotnet publish &quot;$(SourceDir)\NPortugol.Playground\NPortugol.Playground.csproj&quot; -c $(Configuration) -o &quot;$(PlaygroundDir.TrimEnd('\'))&quot; -p:Version=$(ProductVersionBase)$(ProductVersionBuild) --nologo" />

    <ItemGroup>
      <FilesToPlayground Include="$(PlaygroundDir)wwwroot\**\*.*"/>
    </ItemGroup>
    <Zip
    Files="@(FilesToPlayground)"
    ZipLevel="6"
    WorkingDirectory="$(PlaygroundDir)wwwroot"
    ZipFileName="$(BuildDir)\$(PlaygroundName).zip"/>
  </Target>

  <!-- Publica o NPortugol Raio-X (Blazor WebAssembly) e empacota o site estático. -->
  <Target Name="PackageRaioX">
    <RemoveDir Directories="$(RaioXDir)" ContinueOnError="true"/>
    <Exec Command="dotnet publish &quot;$(SourceDir)\NPortugol.RaioX\NPortugol.RaioX.csproj&quot; -c $(Configuration) -o &quot;$(RaioXDir.TrimEnd('\'))&quot; -p:Version=$(ProductVersionBase)$(ProductVersionBuild) --nologo" />

    <ItemGroup>
      <FilesToRaioX Include="$(RaioXDir)wwwroot\**\*.*"/>
    </ItemGroup>
    <Zip
    Files="@(FilesToRaioX)"
    ZipLevel="6"
    WorkingDirectory="$(RaioXDir)wwwroot"
    ZipFileName="$(BuildDir)\$(RaioXName).zip"/>
  </Target>

  <Target Name="Package">

    <ItemGroup>

      <pkg Include="$(BuildDir)*.zip"/>

    </ItemGroup>

    <ItemGroup>
      <CopyToPackage Include="@(pkg)">
        <DestinationFolder>$(PackageDir)</DestinationFolder>
      </CopyToPackage>
    </ItemGroup>

    <Copy
    SourceFiles="@(CopyToPackage)"
    DestinationFiles="@(CopyToPackage->'%(DestinationFolder)/%(RecursiveDir)%(Filename)%(Extension)')"/>

  </Target>

  <Target Name="Merge" DependsOnTargets="Build">
    <ItemGroup>
      <LibraryMerge Include="$(BuildDir)\Npc.exe"/>
      <LibraryMerge Include="$(BuildDir)\NPortugol.dll"/>
      <LibraryMerge Include="$(BuildDir)\Antlr4.Runtime.Standard.dll"/>
    </ItemGroup>
    <MakeDir Directories="$(BuildDir)\temp"/>
    <ILMerge OutputFile="$(BuildDir)\temp\Npc.exe"
      InputAssemblies="@(LibraryMerge)"
      ToolPath="tools\ilmerge"
      LogFile="" Internalize="true"
      TargetPlatformVersion="v4"
      TargetPlatformDirectory="$(WINDIR)\Microsoft.NET\Framework\v4.0.30319"
       />
    <Delete Files="@(LibraryMerge)"></Delete>
    <Move SourceFiles="$(BuildDir)\temp\Npc.exe" DestinationFiles="$(BuildDir)\Npc.exe"/>
  </Target>


  <Target Name="_PreparePackage">

    <ItemGroup>

      <_dependencies Include="$(LibDir)**\*.*"/>
      <!--<_dependencies Include="$(BuildDir)*.*"/>-->

    </ItemGroup>

    <ItemGroup>
      <CopyToPackageDirectory Include="@(_dependencies)">
        <DestinationFolder>$(BuildDir)</DestinationFolder>
      </CopyToPackageDirectory>
    </ItemGroup>

    <Copy
    SourceFiles="@(CopyToPackageDirectory)"
    DestinationFiles="@(CopyToPackageDirectory->'%(DestinationFolder)/%(RecursiveDir)%(Filename)%(Extension)')"/>

  </Target>  



  <Target Name="Integrate">
    <CallTarget Targets="Rebuild;Test;_PreparePackage; PackageGrammarIDE; PackageTNP; PackageLib; PackageNpc; PackagePlayground; PackageRaioX; Package;"></CallTarget>
  </Target>

</Project>
